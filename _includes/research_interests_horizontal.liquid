<div class="col mb-4">
  <div class="card h-100 hoverable">
    <div class="row no-gutters align-items-center">
      {% if interest.img %}
        <div class="col-md-6 d-flex align-items-center">
          {% include figure.liquid loading="eager" path=interest.img sizes="(min-width: 768px) 300px, 50vw" alt="research interest thumbnail" class="card-img" %}
        </div>
      {% endif %}
      <div class="{% if interest.img %}col-md-6{% else %}col-md-12{% endif %}">
        <div class="card-body">
          <h3 class="card-title">{{ interest.title }}</h3>
          {% if interest.description %}
            <p class="card-text">{{ interest.description }}</p>
          {% endif %}
          {% if interest.content and interest.content != '' and interest.content != interest.description %}
            <div class="card-text">{{ interest.content | markdownify }}</div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

